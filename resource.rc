#include <windows.h>
#include "resource.h"
IDI_APP_ICON ICON "app_icon.ico"
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Rom",            40001
        MENUITEM "Free Rom",             40002
        MENUITEM SEPARATOR
        MENUITEM "Reset",                40003
        MENUITEM "Pause",                40004
        MENUITEM SEPARATOR
        MENUITEM "Exit",                 40005
    END
    POPUP "&State"
    BEGIN
        MENUITEM "Save State",           40006
        MENUITEM "Load State",           40007
        MENUITEM SEPARATOR
        MENUITEM "Slot 0\tEmpty",        40008, CHECKED
        MENUITEM "Slot 1\tEmpty",        40009
        MENUITEM "Slot 2\tEmpty",        40010
        MENUITEM "Slot 3\tEmpty",        40011
        MENUITEM "Slot 4\tEmpty",        40012
        MENUITEM "Slot 5\tEmpty",        40013
        MENUITEM "Slot 6\tEmpty",        40014
        MENUITEM "Slot 7\tEmpty",        40015
        MENUITEM "Slot 8\tEmpty",        40016
        MENUITEM "Slot 9\tEmpty",        40017
    END
    POPUP "&Option"
    BEGIN
        POPUP "&Video"
        BEGIN
            MENUITEM "x1 Size",          40019
            MENUITEM "x2 Size",          40020, CHECKED
            MENUITEM "x3 Size",          40021
            MENUITEM "x4 Size",          40022
        END
        MENUITEM "&Key",                 40029
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",            40030
    END
END
IDD_KEY_SETTING DIALOGEX 0, 0, 260, 210
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Key Setting"
FONT 8, "MS Sans Serif"
BEGIN
    COMBOBOX        IDC_PLAYER_COMBO, 5, 5, 40, 50,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "1st", -1, 60,  20, 30, 8
    LTEXT           "2nd", -1, 110, 20, 30, 8
    LTEXT           "3rd", -1, 160, 20, 30, 8
    LTEXT           "4th", -1, 210, 20, 30, 8

    RTEXT           "UP",      -1, 5, 35,  50, 10
    RTEXT           "DOWN",    -1, 5, 50,  50, 10
    RTEXT           "LEFT",    -1, 5, 65,  50, 10
    RTEXT           "RIGHT",   -1, 5, 80,  50, 10
    RTEXT           "A",       -1, 5, 95,  50, 10
    RTEXT           "B",       -1, 5, 110, 50, 10
    RTEXT           "Select",  -1, 5, 125, 50, 10
    RTEXT           "Start",   -1, 5, 140, 50, 10
    RTEXT           "Auto A",  -1, 5, 155, 50, 10
    RTEXT           "Auto B",  -1, 5, 170, 50, 10
    RTEXT           "Speedup", -1, 5, 185, 50, 10

    EDITTEXT        IDC_KEY_UP_1,      60,  33, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_UP_2,      110, 33, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_UP_3,      160, 33, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_UP_4,      210, 33, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_DOWN_1,    60,  48, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_DOWN_2,    110, 48, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_DOWN_3,    160, 48, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_DOWN_4,    210, 48, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_LEFT_1,    60,  63, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_LEFT_2,    110, 63, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_LEFT_3,    160, 63, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_LEFT_4,    210, 63, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_RIGHT_1,   60,  78, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_RIGHT_2,   110, 78, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_RIGHT_3,   160, 78, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_RIGHT_4,   210, 78, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_A_1,       60,  93, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_A_2,       110, 93, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_A_3,       160, 93, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_A_4,       210, 93, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_B_1,       60,  108, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_B_2,       110, 108, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_B_3,       160, 108, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_B_4,       210, 108, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_SELECT_1,  60,  123, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_SELECT_2,  110, 123, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_SELECT_3,  160, 123, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_SELECT_4,  210, 123, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_START_1,   60,  138, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_START_2,   110, 138, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_START_3,   160, 138, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_START_4,   210, 138, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_AUTOA_1,   60,  153, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_AUTOA_2,   110, 153, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_AUTOA_3,   160, 153, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_AUTOA_4,   210, 153, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_AUTOB_1,   60,  168, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_AUTOB_2,   110, 168, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_AUTOB_3,   160, 168, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_AUTOB_4,   210, 168, 45, 12, WS_TABSTOP

    EDITTEXT        IDC_KEY_SPEEDUP_1, 60,  183, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_SPEEDUP_2, 110, 183, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_SPEEDUP_3, 160, 183, 45, 12, WS_TABSTOP
    EDITTEXT        IDC_KEY_SPEEDUP_4, 210, 183, 45, 12, WS_TABSTOP

    DEFPUSHBUTTON   "OK",     IDOK,     150, 192, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 205, 192, 50, 14
	END
1 VERSIONINFO
FILEVERSION     0,8,1,0
PRODUCTVERSION  0,8,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rew. Reborn"
            VALUE "FileDescription",  "Game Boy / Game Boy Color Emulator"
            VALUE "FileVersion",      "0.8.1.0"
            VALUE "InternalName",     "rew_reborn"
            VALUE "OriginalFilename", "rew_reborn.exe"
            VALUE "ProductName",      "Rew. Reborn"
            VALUE "ProductVersion",   "0.8.1-alpha"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
